{
  "description": "Tells the agent (Claude Code or Codex) at session start when to load the stack-audit skills, and checks each file it edits for error-level security findings",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','session_start.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','post_edit.py'),run_name='__main__')\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
