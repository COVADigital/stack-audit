{
  "description": "Tells Claude at session start when to load the stack-audit skills, and checks each file Claude edits for error-level security findings",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/post_edit.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
